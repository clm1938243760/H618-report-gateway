[Unit]
Description=KICKPI K2B report gateway HTTPS configuration and upload service
# The HTTPS listener can bind before an interface receives an address. Keep the
# update agent parallel so network-online delays never block local management.
After=local-fs.target network.target
Wants=jvlei-updater.service

[Service]
Type=simple
WorkingDirectory=/opt/gadget-msc-printer
Environment=PYTHONPATH=/opt/gadget-msc-printer/src
ExecStart=/opt/gadget-msc-printer/.venv/bin/python -m gadget_msc_printer.web_main --config /etc/gadget-msc-printer/config.yaml
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
